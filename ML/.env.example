# Speak2HR Backend Environment Configuration
# Add your Google Gemini API Key below
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Dedicated keys for parallel processing
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# Optional: Gemini model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: Email notification settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# JWT Signing Secret (Generate a strong 256-bit+ random secret in production)
JWT_SECRET=your_secure_random_jwt_signing_secret_here

# CORS Configuration (comma-separated allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
